{
  "name": "ONYX - for the MONO wallet",
  "short_name": "ONYX",
  "description": "Open, ring and find your MONO fingerprint wallet.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0B0B0B",
